<?xml version="1.0" encoding="UTF-8"?>
<!--
  The values one preset of the demonstration composes from, read when that preset loads. The name is
  what the preset selector shows it as, and the scenario is which composition it opens. The function
  is named as the demonstration registers it. This file ships with the repository and is read until
  the preset has been saved; a save writes a copy of it under the directory the application keeps its
  state in, and that copy is what is read from then on.
-->
<optimization>
    <preset name="Minimization: (x^2 + 10y^2)/2" scenario="surface"/>
    <function name="(x^2 + 10y^2)/2"/>
    <range x_lower="-2" x_upper="2" y_lower="-2" y_upper="2"/>
    <seed x="-2" y="-2"/>
    <solve limit="500" step="0" form="minimum" method="newton" step_length="0.1"/>
</optimization>
